#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) buffer InData {
    float in_data[]; // [batch_size, in_c, in_h, in_w]
};

layout(set = 0, binding = 1) buffer Weights {
    float weights[]; // [out_c, in_c, k_h, k_w]
};

layout(set = 0, binding = 2) buffer Biases {
    float biases[];  // [out_c]
};

layout(set = 0, binding = 3) buffer OutData {
    float out_data[]; // [batch_size, out_c, out_h, out_w]
};

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint in_c;
    uint in_h;
    uint in_w;
    uint out_c;
    uint out_h;
    uint out_w;
    uint k_size;
    uint stride;
    uint pad;
};

void main() {
    uint ow = gl_GlobalInvocationID.x; // [0, out_w)
    uint oh = gl_GlobalInvocationID.y; // [0, out_h)
    uint oc_b = gl_GlobalInvocationID.z; // batch_idx * out_c + oc

    uint oc = oc_b % out_c;
    uint b  = oc_b / out_c;

    if (ow >= out_w || oh >= out_h || b >= batch_size)
        return;

    float sum = biases[oc];

    int in_y_origin = int(oh * stride) - int(pad);
    int in_x_origin = int(ow * stride) - int(pad);

    for (uint ic = 0; ic < in_c; ++ic) {
        for (uint kh = 0; kh < k_size; ++kh) {
            int iy = in_y_origin + int(kh);
            if (iy < 0 || iy >= int(in_h)) continue;

            for (uint kw = 0; kw < k_size; ++kw) {
                int ix = in_x_origin + int(kw);
                if (ix < 0 || ix >= int(in_w)) continue;

                uint in_idx = ((b * in_c + ic) * in_h + uint(iy)) * in_w + uint(ix);
                uint w_idx  = ((oc * in_c + ic) * k_size + kh) * k_size + kw;

                sum += in_data[in_idx] * weights[w_idx];
            }
        }
    }

    uint out_idx = ((b * out_c + oc) * out_h + oh) * out_w + ow;
    out_data[out_idx] = sum;
}

